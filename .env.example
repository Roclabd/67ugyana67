# Скопировать в .env и заполнить. .env в git не коммитится.

# Ключ шифрования секретов нод (AES-GCM, 32 байта в base64)
APP_SECRETS_KEY=

# LLM: любой OpenAI-совместимый провайдер или локальный Ollama/vLLM
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5-coder:7b
LLM_API_KEY=

# Публичный HTTP(S)-адрес интерфейса для ссылок на запуски в уведомлениях
APP_PUBLIC_URL=

# Уведомления для демо
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Команды Telegram-бота (/status, /last, /run <ссылка>, /help) через long polling; отвечает только чатам из TELEGRAM_CHAT_ID и настроек Telegram. По умолчанию выключено.
TELEGRAM_BOT_COMMANDS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TO=

# Токен для вызова из CI
CI_TOKEN=
# Полная проверка SECRET / SCA / SAST. Для другого состава нод задайте подпись его отчёта.
CI_RULES_VERSION=codeguard-rules-v2+sast-1

# Запись базовой линии и действия пользователя через API
APP_REVIEW_TOKEN=

# Подпись входящих решений Telegram. Для группы задайте ID утверждающего.
TELEGRAM_APPROVAL_WEBHOOK_SECRET=
TELEGRAM_APPROVER_USER_ID=

# APP_BIND_ADDRESS=127.0.0.1
# APP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# PORT=8080

# Исходящий HTTP-прокси для GitHub, Telegram, вебхуков и внешней LLM (при VPN с подменой DNS); пусто - напрямую. SMTP не проксируется.
# APP_OUTBOUND_PROXY=http://127.0.0.1:10809

# Разрешённые репозитории для источника «клон по ссылке» (через запятую)
ALLOWED_REPOS=https://github.com/example-org/training
