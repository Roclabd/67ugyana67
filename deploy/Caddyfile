# Автоматический HTTPS (Let's Encrypt) для домена из переменной DOMAIN.
# Приложение наружу не опубликовано: единственный вход - этот прокси.
{$DOMAIN} {
	encode zstd gzip

	# Лимит тела запроса чуть выше лимита ZIP (25 МБ) в самом приложении.
	request_body {
		max_size 27MB
	}

	reverse_proxy app:8080 {
		# Адрес клиента для лимитов запусков: перезаписываем, а не дополняем заголовок посетителя.
		header_up X-Forwarded-For {remote_host}
		# События выполнения (SSE) отдаются сразу, без буферизации.
		flush_interval -1
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
}
